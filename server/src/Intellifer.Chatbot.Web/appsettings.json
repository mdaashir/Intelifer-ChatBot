{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "Intellifer.Chatbot",
    "Audience": "Intellifer.Chatbot.Client",
    "SigningKey": "",
    "ExpiryMinutes": 60
  },
  "SeedAdmin": {
    "Email": "",
    "Password": ""
  },
  "Bot": {
    "Mode": "Auto",
    "SystemPrompt": "You are the Intellifer assistant, a helpful and concise chatbot. Keep replies short and friendly.",
    "HistoryMessages": 20,
    "Ai": {
      "Provider": "OpenAi",
      "BaseUrl": "",
      "ApiKey": "",
      "Model": "gpt-4o-mini",
      "MaxTokens": 512,
      "TimeoutSeconds": 15
    }
  }
}
